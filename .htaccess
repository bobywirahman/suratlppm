# Apache Configuration for LPPM FDK Surat System
RewriteEngine On

# Protect sensitive files
<FilesMatch "^\.">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Prevent directory listing
Options -Indexes

# Set default charset
AddDefaultCharset UTF-8

# Enable GZIP compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript
</IfModule>

# Security Headers
RewriteCond %{HTTP:X-Frame-Options} no
RewriteRule .* - [F]

# Protect config files
<FilesMatch "^(config|includes|models|controllers)\.(php)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>
