# ===================================================
# Security hardening untuk folder uploads
# uploads hanya boleh menyimpan file non-eksekusi
# (gambar, PDF, dll.) dari user/aplikasi.
# Berlaku juga untuk semua subfolder (informasi,
# settings, syarat, dst).
# ===================================================

# Mencegah listing direktori
Options -Indexes

# Blokir akses file dot (mis. .htaccess, .env) di folder ini
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Allow,Deny
        Deny from all
    </IfModule>
</FilesMatch>

# Blokir eksekusi/akses file PHP (dan jenis eksekusi lain)
# di seluruh folder uploads, KECUALI tiny_upload.php
# (helper sah yang dipakai aplikasi).
<FilesMatch "^(?i)(?!tiny_upload\.php$).*\.(php|phtml|php3|php4|php5|php6|php7|php8|phar|pht|shtml|cgi)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Allow,Deny
        Deny from all
    </IfModule>
</FilesMatch>